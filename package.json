{
  "name": "@commonagents/cli",
  "version": "0.1.0",
  "description": "Reference implementation of the Common Agent Format: validate CAF agents and install them into coding harnesses.",
  "keywords": [
    "common-agent-format",
    "caf",
    "ai-agents",
    "subagents",
    "claude-code",
    "copilot",
    "codex",
    "gemini-cli",
    "cursor",
    "kiro",
    "antigravity"
  ],
  "homepage": "https://commonagents.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/common-agents/cli.git"
  },
  "bugs": "https://github.com/common-agents/cli/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "caf": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-schema": "node scripts/sync-schema.mjs",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
